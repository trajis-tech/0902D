  "uiParameterTemplates": [
    {
      "key": "rect_mu_pct",
      "label": "單高斯 μ 相對 G",
      "type": "number",
      "description": "μ_rect' = G × (1 + 此值/100)。x 原檔 G−8.42% 約為 172。單位：%"
    },
    {
      "key": "rect_sigma2",
      "label": "單高斯 σ²",
      "type": "number",
      "description": "鏈 A 變異數，規格維持 25（不是灰階）"
    },
    {
      "key": "min_area_ratio",
      "label": "最小面積比",
      "type": "number",
      "description": "候選矩形面積須達整張影像的比例"
    },
    {
      "key": "rect_bin_pct",
      "label": "找框二值相對 G",
      "type": "number",
      "description": "原圖 THRESH_BINARY 門檻 = G × (1 + 此值/100)，非反轉。x 原檔約為 180。單位：%"
    },
    {
      "key": "solder_reference_ceiling_pct",
      "label": "焊錫基準候選上限",
      "type": "number",
      "description": "僅用來排除太白的氣泡/空焊像素，再從四個理想 ROI 的暗色主峰估計焊錫灰階基準 S。候選上限 = G × (1 + 此值/100)。單位：%"
    },
    {
      "key": "solder_full_weight_offset_pct",
      "label": "100% 焊錫端偏移",
      "type": "number",
      "description": "確定焊錫上限 = S + G × 此值/100。低於此灰階的 ROI 像素給焊錫權重 1。可獨立於空缺端調整。單位：%"
    },
    {
      "key": "void_zero_weight_offset_pct",
      "label": "0% 焊錫／完全空缺端偏移",
      "type": "number",
      "description": "確定空缺下限 = S + G × 此值/100。高於此灰階的 ROI 像素給焊錫權重 0；必須大於 100% 焊錫端偏移。單位：%"
    },
    {
      "key": "ideal_shift_max_px",
      "label": "理想輪廓 X/Y 搜尋範圍",
      "type": "number",
      "description": "每顆解析式理想膠囊沿 X 與 Y 軸平移的最大搜尋距離（像素）。程式以 1 px 步進搜尋，使 raw X-ray 加權空焊面積占比最小；尺寸、角度與形狀不變。"
    },
    {
      "key": "pair_min_distance_px",
      "label": "同排兩 R 最小距離",
      "type": "number",
      "description": "R1-R2 或 R3-R4 的輪廓邊界最短距離若小於此值，整體檢查直接 FAIL。單位：px。"
    },
    {
      "key": "relative_shift_warning_px",
      "label": "四 R 位移離散警告值",
      "type": "number",
      "description": "四個 R 的最佳 dx 或 dy 最大值減最小值，任一方向大於此值即輸出 WARNING。單位：px。"
    },
    {
      "key": "crop_ratio",
      "label": "中央裁剪比例",
      "type": "number",
      "description": "裁剪寬高為大矩形的此比例，中心對齊"
    }
  ],
